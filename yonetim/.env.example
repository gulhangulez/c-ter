# Çince Tercüman yönetim uygulaması — örnek ayarlar.
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun. .env dosyası ASLA depoya eklenmez.

NODE_ENV=production
PORT=3000
# Panelin ve güvenli yanıt bağlantılarının açılacağı adres (sonunda / olmadan)
BASE_URL=https://panel.cince-tercuman.com
DATABASE_URL=postgres://kullanici:sifre@localhost:5432/cince_yonetim
# En az 32 karakter rastgele değer: openssl rand -hex 32
APP_SECRET=
ADMIN_TIMEZONE=Europe/Istanbul
# Tek süreç çalıştırabilen barındırmalarda (cPanel Web Apps) arka plan işçisini web süreci içinde çalıştırır
RUN_WORKER_IN_WEB=0
# Komut satırı yoksa: hiç kullanıcı yokken ilk yöneticiyi bu bilgilerle oluşturur (kullanıcı varsa yok sayılır)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- WhatsApp Business Platform (Meta Cloud API) ---
# FAKE: hiçbir mesaj gönderilmez (test). LIVE: gerçek gönderim.
WHATSAPP_MODE=FAKE
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Meta uygulamasının "App secret" değeri (webhook imzası X-Hub-Signature-256 için)
WHATSAPP_APP_SECRET=
# Webhook kurulumunda Meta'ya yazacağınız, sizin belirlediğiniz doğrulama metni
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=tr
# Meta'da onaylanan şablonlar: anahtar=şablon_adı, virgülle ayrılır.
# 24 saatlik pencere dışında yalnızca burada listelenen şablonlar gönderilir; eksik şablon "Müdahale" listesine düşer.
WHATSAPP_APPROVED_TEMPLATES=

# --- Google Takvim ---
# FAKE / LIVE / DISABLED. LIVE'da bağlantı Ayarlar > Google Takvim'i bağla ile yapılır.
CALENDAR_MODE=FAKE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=

# --- Ödeme doğrulama ---
# Şimdilik yalnızca FAKE (test) veya DISABLED. Gerçek sağlayıcı seçilince eklenecek.
PAYMENTS_MODE=FAKE
PAYMENTS_PROVIDER=fake
PAYMENTS_WEBHOOK_SECRET=

# --- Telefon (isteğe bağlı, varsayılan kapalı) ---
TELEPHONY_MODE=DISABLED
TELEPHONY_WEBHOOK_SECRET=

# --- E-posta bildirimi (acil istisnalar ve günlük özet) ---
# LOG: yalnızca sunucu günlüğüne yazar. RESEND: Resend API ile gönderir.
EMAIL_MODE=LOG
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
