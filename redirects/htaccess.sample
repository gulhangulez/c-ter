# Apache / LiteSpeed (.htaccess). Rename to .htaccess in the web root only after
# testing; if TLS is terminated by a proxy, replace the %{HTTPS} condition with
# the host's verified variable to avoid a redirect loop.
Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# 1) Old equivalents -> final HTTPS URL in a single 301 (also from http / bare host).
RewriteRule ^faq/cincetercuman-nedir/?$ https://www.cince-tercuman.com/hakkimizda/ [R=301,L,NE]
RewriteRule ^faq/bize-gondereceginiz-kisinin-cinceyi-iyi-bildiginden-nasil-emin-olabilirim/?$ https://www.cince-tercuman.com/rehber/cince-tercuman-nasil-secilir/#q-q103 [R=301,L,NE]
RewriteRule ^faq/bize-yonlendireceginiz-tercumani-neye-gore-seciyorsunuz/?$ https://www.cince-tercuman.com/rehber/cince-tercuman-nasil-secilir/#q-q053 [R=301,L,NE]
RewriteRule ^faq/size-nasil-ulasabiliriz/?$ https://www.cince-tercuman.com/iletisim/ [R=301,L,NE]
RewriteRule ^faq/nasil-tercuman-talebinde-bulunabilirim/?$ https://www.cince-tercuman.com/rehber/tercuman-talebi-icin-gerekli-bilgiler/ [R=301,L,NE]
RewriteRule ^faq/tercuman-talebinde-bulundum-baska-birsey-yapmam-gerekiyor-mu/?$ https://www.cince-tercuman.com/sik-sorulan-sorular/#q-q041 [R=301,L,NE]
RewriteRule ^faq/size-odemeyi-nasil-yapacagim/?$ https://www.cince-tercuman.com/cince-tercuman-fiyatlari/#q-q014 [R=301,L,NE]
RewriteRule ^faq/bulundugum-sehirde-tercuman-yok-ve-baska-bir-sehirden-gelecek-masraflari-bize-mi-ait/?$ https://www.cince-tercuman.com/cince-tercuman-fiyatlari/#q-q010 [R=301,L,NE]
RewriteRule ^faq/eger-memnun-kalmazsak-ne-yapmam-gerekiyor/?$ https://www.cince-tercuman.com/sik-sorulan-sorular/#q-q046 [R=301,L,NE]
RewriteRule ^sitemap_index\.xml/?$ https://www.cince-tercuman.com/sitemap.xml [R=301,L,NE]
RewriteRule ^page-sitemap\.xml/?$ https://www.cince-tercuman.com/sitemap.xml [R=301,L,NE]
RewriteRule ^post-sitemap\.xml/?$ https://www.cince-tercuman.com/sitemap.xml [R=301,L,NE]
RewriteRule ^faq-sitemap\.xml/?$ https://www.cince-tercuman.com/sitemap.xml [R=301,L,NE]

# 2) Deliberately removed pages -> real 410 (never redirected to the home page).
RewriteRule ^cince-ceviri/?$ - [G,L]
RewriteRule ^web-sitenizi-cinceye-cevirin/?$ - [G,L]
RewriteRule ^cince-tercumani-olarak-kayit-olun/?$ - [G,L]
RewriteRule ^testimonial/?$ - [G,L]
<If "%{REQUEST_URI} =~ m#^/(cince-ceviri|web-sitenizi-cinceye-cevirin)/?$#">
  ErrorDocument 410 /410-yazili-ceviri.html
</If>
<Else>
  ErrorDocument 410 /410.html
</Else>

# 3) One canonical host: https://www.cince-tercuman.com
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.cince-tercuman\.com$ [NC]
RewriteRule ^ https://www.cince-tercuman.com%{REQUEST_URI} [R=301,L,NE]

# 4) Directory URLs without the trailing slash -> slash version (one hop).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ https://www.cince-tercuman.com/$1/ [R=301,L,NE]

# 5) Real 404 for everything else (no SPA fallback to index.html).
ErrorDocument 404 /404.html

# 6) ES modules need a JavaScript MIME type for the contact form.
AddType text/javascript .js .mjs
AddType font/woff2 .woff2
