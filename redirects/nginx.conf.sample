  location ~ ^/faq/bulundugum-sehirde-tercuman-yok-ve-baska-bir-sehirden-gelecek-masraflari-bize-mi-ait/?$ { return 301 https://www.cince-tercuman.com/cince-tercuman-fiyatlari/#q-q010; }
