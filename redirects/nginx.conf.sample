  location ~ ^/page-sitemap\.xml/?$ { return 301 https://www.cince-tercuman.com/sitemap.xml; }
  location ~ ^/post-sitemap\.xml/?$ { return 301 https://www.cince-tercuman.com/sitemap.xml; }
  location ~ ^/faq-sitemap\.xml/?$ { return 301 https://www.cince-tercuman.com/sitemap.xml; }
  location ~ ^/cince-ceviri/?$ { error_page 410 /410-yazili-ceviri.html; return 410; }
