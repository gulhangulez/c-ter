# nginx server block sample.
server {
  listen 80;
  listen 443 ssl;
  server_name cince-tercuman.com www.cince-tercuman.com;
  if ($host != "www.cince-tercuman.com") { return 301 https://www.cince-tercuman.com$request_uri; }
  if ($scheme != "https") { return 301 https://www.cince-tercuman.com$request_uri; }

  root /var/www/cince-tercuman/dist;
  index index.html;
  types { text/javascript js mjs; font/woff2 woff2; text/css css; text/html html; application/xml xml; text/plain txt; image/svg+xml svg; }

  location ~ ^/faq/cincetercuman-nedir/?$ { return 301 https://www.cince-tercuman.com/hakkimizda/; }
